# --- Core ---
APP_ENV=development
DEMO_MODE=true
MOCK_EXTERNAL_APIS=true

# --- Database ---
# In DEMO_MODE the app defaults to a local SQLite file (./data/aroc.db) via the
# same repository layer, so this can be left blank for local/offline demo runs.
# For a real deployment point this at managed Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aroc
DATABASE_URL=

# --- AI (OpenRouter) ---
# Never exposed to the frontend. If absent, the copilot automatically uses the
# deterministic fallback responder (still backed by real tool calls / real data).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Optional external services ---
MAPTILER_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
